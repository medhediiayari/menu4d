# ─── Menu4D Environment Variables ────────────────
# Copy this file to .env and fill in your values

# PostgreSQL
DATABASE_URL=postgresql://menu4d:menu4d_secret@postgres:5432/menu4d

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=menu4d_admin
MINIO_SECRET_KEY=menu4d_secret_key
MINIO_BUCKET=menu4d-files
MINIO_USE_SSL=false

# JWT
JWT_SECRET=CHANGE-THIS-TO-A-RANDOM-64-CHAR-STRING

# Server
PORT=3000
NODE_ENV=production
